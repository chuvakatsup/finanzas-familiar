# =============================================================================
# Producción (VPS). Copia este archivo a `.env`, llena los valores y NUNCA lo subas a git.
#   Generar contraseñas (solo letras/números, van dentro de una URL):  openssl rand -hex 32
# =============================================================================

# Subdominio público (sin https://). Nginx del host hace de proxy hacia APP_HOST_PORT.
APP_DOMAIN=finanzas.midominio.com
APP_URL=https://finanzas.midominio.com
# Puerto en 127.0.0.1 del VPS donde escucha la app (3000 ya está ocupado).
APP_HOST_PORT=3020

# Base de datos (solo accesible dentro de la red interna de Docker).
POSTGRES_USER=finanzas
POSTGRES_DB=finanzas
POSTGRES_PASSWORD=cambia-esto-por-algo-largo-y-aleatorio

# ---------------- Respaldos ----------------
# Llave PÚBLICA de age (age1...). La privada se guarda FUERA del VPS (ver README).
BACKUP_AGE_RECIPIENT=
# Hora diaria del respaldo (hora de Mazatlán, HH:MM).
BACKUP_TIME=03:15
# Usuario (uid) dueño de la carpeta ./backups en el VPS.
BACKUP_UID=1000
# Destino rclone opcional para copia fuera del VPS, p. ej. "b2:mi-bucket/finanzas".
# Requiere docker/backup/rclone/rclone.conf (ver README). Vacío = sin copia externa.
RCLONE_REMOTE=
# URL opcional para avisar que el respaldo terminó (healthchecks.io, Uptime Kuma push...).
BACKUP_PING_URL=
