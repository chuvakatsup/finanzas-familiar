{
  "name": "finanzas-familiar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:up": "docker compose -f compose.dev.yml up -d --wait",
    "db:down": "docker compose -f compose.dev.yml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:seed": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/create-admin.ts",
    "build:scripts": "node scripts/build-scripts.mjs",
    "icons": "tsx scripts/generate-icons.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22"
  }
}
